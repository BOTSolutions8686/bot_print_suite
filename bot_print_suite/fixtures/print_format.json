  "html": "<div style='font-family:Arial,sans-serif;padding:10px;color:#1f2937'><div style='font-size:15px;font-weight:700;color:#1B2A4A'>Golden Arrow Printing &amp; Packaging Co.</div><div style='display:flex;justify-content:space-between;border-bottom:3px solid #b78b2e;padding:10px 0;margin-bottom:16px'><div><small>JOB TICKET / بطاقة العمل</small><div style='font-size:25px;font-weight:700;font-family:monospace'>{{ doc.name }}</div></div><div style='text-align:right'><small>Status / الحالة</small><div style='font-size:16px;font-weight:700'>{{ doc.custom_job_status or \"Prepress\" }}</div></div></div><table style='width:100%;margin-bottom:14px'><tr><td><small>Customer / العميل</small><br><b>{{ doc.customer_name or doc.customer }}</b></td><td><small>Customer PO / رقم أمر الشراء</small><br><b>{{ doc.po_no or \"-\" }}</b></td></tr><tr><td><small>Delivery Date / تاريخ التسليم</small><br><b>{{ frappe.utils.formatdate(doc.delivery_date) if doc.delivery_date else \"-\" }}</b></td><td><small>Order Date / تاريخ الطلب</small><br><b>{{ frappe.utils.formatdate(doc.transaction_date) }}</b></td></tr></table><h4 style='color:#1B2A4A;border-bottom:1px solid #ccc'>Job Specification / مواصفات العمل</h4><table style='width:100%;border-collapse:collapse;font-size:12px'><thead><tr style='background:#f2f4f8'><th style='text-align:left;padding:7px;border:1px solid #ddd'>Item / الصنف</th><th style='text-align:right;padding:7px;border:1px solid #ddd'>Qty / الكمية</th></tr></thead><tbody>{% for row in doc.items %}<tr><td style='padding:7px;border:1px solid #ddd;line-height:1.5'>{{ row.description or row.item_name or row.item_code }}</td><td style='text-align:right;padding:7px;border:1px solid #ddd'>{{ \"{:,.0f}\".format(row.qty) }}</td></tr>{% endfor %}</tbody></table><div style='margin-top:20px;padding:10px;border:1px dashed #999;font-size:11px'>Routing: Prepress &rarr; CTP &rarr; Press &rarr; Finishing &rarr; QC &rarr; Delivery<br>Operator sign-off / توقيع المشغل: ______________________</div></div>",
