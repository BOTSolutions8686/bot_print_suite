  "html": "<div style='font-family:Arial,sans-serif;padding:10px;color:#1f2937'><div style='display:flex;justify-content:space-between;border-bottom:3px solid #b78b2e;padding-bottom:12px;margin-bottom:18px'><div><div style='font-size:21px;font-weight:700;color:#1B2A4A'>Golden Arrow Printing &amp; Packaging Co.</div><div style='font-size:11px;color:#666'>Printing &amp; Packaging / الطباعة والتغليف</div></div><div style='text-align:right'><small>Quotation / عرض السعر</small><div style='font-size:16px;font-weight:700'>{{ doc.name }}</div><small>{{ frappe.utils.formatdate(doc.transaction_date) }}</small></div></div><div style='margin-bottom:16px'><small>To / إلى</small><div style='font-size:15px;font-weight:700'>{{ doc.customer_name or doc.party_name }}</div></div><table style='width:100%;border-collapse:collapse;font-size:12px'><thead><tr style='background:#1B2A4A;color:white'><th style='text-align:left;padding:8px'>Description / الوصف</th><th style='text-align:right;padding:8px'>Qty / الكمية</th><th style='text-align:right;padding:8px'>Rate / السعر</th><th style='text-align:right;padding:8px'>Amount / المبلغ</th></tr></thead><tbody>{% for row in doc.items %}<tr style='border-bottom:1px solid #ddd'><td style='padding:9px;line-height:1.5'>{{ row.description or row.item_name or row.item_code }}</td><td style='text-align:right;padding:9px'>{{ \"{:,.0f}\".format(row.qty) }}</td><td style='text-align:right;padding:9px'>{{ frappe.utils.fmt_money(row.rate,currency=doc.currency) }}</td><td style='text-align:right;padding:9px'>{{ frappe.utils.fmt_money(row.amount,currency=doc.currency) }}</td></tr>{% endfor %}</tbody></table><div style='text-align:right;margin-top:16px;font-size:16px;font-weight:700'>Grand Total / الإجمالي: {{ frappe.utils.fmt_money(doc.grand_total,currency=doc.currency) }}</div><div style='margin-top:26px;font-size:10px;color:#777;border-top:1px solid #ddd;padding-top:9px'>This quotation is subject to Golden Arrow Printing &amp; Packaging Co.'s standard terms. Prices exclude VAT unless stated.<br><span dir='rtl'>هذا العرض خاضع للشروط والأحكام القياسية لشركة السهم الذهبي للطباعة والتغليف. الأسعار غير شاملة ضريبة القيمة المضافة ما لم يذكر خلاف ذلك.</span></div></div>",
