  "format_data": null,
  "html": "<div style='font-family:Arial,Tahoma,sans-serif;color:#172033;padding:4px 8px'><div style='border-top:8px solid #c49a3a;padding-top:18px;display:flex;justify-content:space-between;align-items:flex-start'><div><div style='font-size:24px;font-weight:800;color:#172b4d;letter-spacing:.2px'>GOLDEN ARROW</div><div style='font-size:13px;font-weight:600;color:#c49a3a;margin-top:2px'>Printing &amp; Packaging Co.</div><div dir='rtl' style='font-size:12px;color:#566176;margin-top:3px'>شركة السهم الذهبي للطباعة والتغليف</div></div><div style='text-align:right'><div style='font-size:12px;color:#6b7280;text-transform:uppercase;letter-spacing:1px'>Quotation / عرض سعر</div><div style='font-size:20px;font-weight:800;color:#172b4d;margin:4px 0'>{{ doc.name }}</div><div style='font-size:11px;color:#6b7280'>Date / التاريخ: {{ frappe.utils.formatdate(doc.transaction_date) }}</div>{% if doc.valid_till %}<div style='font-size:11px;color:#6b7280'>Valid until / صالح حتى: {{ frappe.utils.formatdate(doc.valid_till) }}</div>{% endif %}</div></div><div style='margin:20px 0 16px;background:#f7f8fa;border-left:4px solid #c49a3a;border-radius:4px;padding:12px 14px;display:flex;justify-content:space-between'><div><div style='font-size:10px;text-transform:uppercase;letter-spacing:.7px;color:#7b8495'>Prepared for / مقدم إلى</div><div style='font-size:15px;font-weight:700;margin-top:4px'>{{ doc.customer_name or doc.party_name }}</div>{% if doc.address_display %}<div style='font-size:10px;color:#687386;margin-top:4px;line-height:1.45'>{{ doc.address_display }}</div>{% endif %}</div><div style='text-align:right;font-size:11px;color:#566176'>{% if doc.contact_display %}<b>Contact / جهة الاتصال</b><br>{{ doc.contact_display }}{% endif %}{% if doc.contact_email %}<br>{{ doc.contact_email }}{% endif %}</div></div><table style='width:100%;border-collapse:collapse;font-size:11px'><thead><tr style='background:#172b4d;color:#fff'><th style='text-align:left;padding:10px 9px;width:55%'>Description / الوصف</th><th style='text-align:right;padding:10px 9px'>Qty / الكمية</th><th style='text-align:right;padding:10px 9px'>Unit Rate / سعر الوحدة</th><th style='text-align:right;padding:10px 9px'>Amount / المبلغ</th></tr></thead><tbody>{% for row in doc.items %}<tr style='border-bottom:1px solid #dfe3e8;page-break-inside:avoid'><td style='padding:11px 9px;line-height:1.55'>{{ row.description or row.item_name or row.item_code }}</td><td style='text-align:right;padding:11px 9px;white-space:nowrap'>{{ \"{:,.0f}\".format(row.qty) }}</td><td style='text-align:right;padding:11px 9px;white-space:nowrap'>{{ frappe.utils.fmt_money(row.rate,currency=doc.currency) }}</td><td style='text-align:right;padding:11px 9px;white-space:nowrap;font-weight:700'>{{ frappe.utils.fmt_money(row.amount,currency=doc.currency) }}</td></tr>{% endfor %}</tbody></table><div style='display:flex;justify-content:flex-end;margin-top:18px;page-break-inside:avoid'><table style='width:58%;border-collapse:collapse;font-size:12px'><tr><td style='padding:7px 9px;color:#5f6979'>Subtotal / المجموع قبل الضريبة</td><td style='padding:7px 9px;text-align:right;font-weight:600;white-space:nowrap'>{{ frappe.utils.fmt_money(doc.net_total,currency=doc.currency) }}</td></tr>{% for tax in doc.taxes %}{% if tax.tax_amount %}<tr><td style='padding:7px 9px;color:#5f6979'>{{ tax.description or 'VAT 15% / ضريبة القيمة المضافة ١٥٪' }}</td><td style='padding:7px 9px;text-align:right;font-weight:600;white-space:nowrap'>{{ frappe.utils.fmt_money(tax.tax_amount,currency=doc.currency) }}</td></tr>{% endif %}{% endfor %}<tr style='background:#172b4d;color:#fff;border-top:3px solid #c49a3a'><td style='padding:11px 9px;font-size:14px;font-weight:800;color:#fff'>Grand Total / الإجمالي شامل الضريبة</td><td style='padding:11px 9px;text-align:right;font-size:14px;font-weight:800;white-space:nowrap;color:#fff'>{{ frappe.utils.fmt_money(doc.grand_total,currency=doc.currency) }}</td></tr></table></div>{% if doc.in_words %}<div style='margin-top:10px;text-align:right;font-size:10px;color:#6b7280'>Amount in words / المبلغ كتابة: {{ doc.in_words }}</div>{% endif %}<div style='margin-top:30px;border-top:1px solid #d9dee7;padding-top:12px;display:flex;gap:22px;font-size:10px;color:#687386;line-height:1.55'><div style='width:50%'><b style='color:#172b4d'>Terms / الشروط</b><br>Prices include 15% VAT as shown above.<br><span dir='rtl'>الأسعار تشمل ضريبة القيمة المضافة بنسبة ١٥٪ كما هو موضح أعلاه.</span></div><div style='width:50%;text-align:right'><b style='color:#172b4d'>Thank you / شكراً لكم</b><br>We appreciate the opportunity to serve you.<br><span dir='rtl'>نشكر لكم فرصة خدمتكم.</span></div></div><div style='margin-top:18px;text-align:center;font-size:9px;color:#9aa1ad;border-top:1px solid #eceff3;padding-top:8px'>Golden Arrow Printing &amp; Packaging Co. &nbsp;|&nbsp; شركة السهم الذهبي للطباعة والتغليف</div></div>",
